<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="TOP_LEFT" spacing="15.0" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.peeps.tools.springgenie.fx.controller.ModelController">

    <padding>
        <Insets bottom="20" left="20" right="20" top="20" />
    </padding>

    <Label prefHeight="30.0" prefWidth="383.0" style="-fx-font-size: 20px; -fx-font-weight: bold;" text="SpringGenie - Model Generator">
      <font>
         <Font size="20.0" />
      </font></Label>

    <HBox spacing="10">
        <Label text="Class Name:" />
        <TextField fx:id="classNameField" promptText="Enter model class name" />
    </HBox>

    <VBox spacing="10">
        <Label text="Fields:" />
        <TableView fx:id="fieldsTable" editable="true" prefHeight="200">
            <columns>
                <TableColumn fx:id="fieldNameColumn" prefWidth="98.0" sortable="false" text="Field Name" />
                <TableColumn fx:id="fieldTypeColumn" prefWidth="114.0" sortable="false" text="Field Type" />
            <TableColumn prefWidth="163.0" text="Column X" />
            </columns>
        </TableView>

        <HBox spacing="10">
            <TextField fx:id="newFieldName" promptText="Field Name" />
            <TextField fx:id="newFieldType" promptText="Field Type" />
            <Button onAction="#handleAddField" text="Add Field" />
        </HBox>
    </VBox>

    <Button onAction="#handleGenerateModel" text="Generate Model Class" />

</VBox>
